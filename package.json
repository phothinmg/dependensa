{
  "name": "dependensa",
  "version": "0.2.1",
  "description": "Static analysis tool for TypeScript and JavaScript projects — produces dependency graphs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phothinmg/dependensa"
  },
  "keywords": [
    "dependency-graph",
    "static-analysis",
    "typescript",
    "javascript",
    "napi",
    "native"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "napi": {
    "binaryName": "dependensa",
    "packageName": "@suseejs/dependensa",
    "targets": [
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "artifacts": "napi artifacts"
  },
  "engines": {
    "node": ">= 20.17.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  }
}
